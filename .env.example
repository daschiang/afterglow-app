# 到 https://platform.openai.com 註冊帳號，左側選單找 API keys 建立一把新的
# 需要先在 Billing 設定付款方式（OpenAI 沒有長期免費額度，依用量計費）
# 金鑰格式類似 sk-xxxxxxxxxxxxxxxx，複製後貼在下面（只會顯示一次）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用的模型，預設用 gpt-5.6-terra（速度與品質平衡）
# 想省更多可以換成 gpt-5.6-luna；其他可選模型看
# https://platform.openai.com/docs/pricing
OPENAI_MODEL=gpt-5.6-terra

# 伺服器監聽的 port，部署平台通常會自動注入這個變數，本機測試可不改
PORT=3000

# ---- 後台用量統計（選填）----
# 設定這個密碼後，才能打開 /admin 看用量統計（帳號固定是 admin）。
# 不設定的話 /admin 會直接回 404，不會有一個沒密碼保護的後台曝露在外面。
ADMIN_PASSWORD=

# 用量統計資料庫存放路徑，預設是專案資料夾裡的 data/usage.db。
# 部署到 Render 的話，這裡要指到一個有掛「Persistent Disk」的目錄（例如 /data/usage.db），
# 不然每次重新部署或重啟，統計資料就會被清空歸零，詳見 README。
DB_PATH=

# 後台估算花費用的單價（美金／每百萬 tokens），預設對應 gpt-5.6-terra。
# 如果換了 OPENAI_MODEL，記得也把這兩個價格改成新模型的實際單價，不然後台顯示的花費會不準。
PRICE_INPUT_PER_1M=2.0
PRICE_OUTPUT_PER_1M=12.0
